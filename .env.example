# Copy to .env and fill in the keys. Every variable maps to a field of
# research_agent.config.Settings (upper-cased name); anything not set here uses the
# code default. Experiment settings belong in configs/ablations/*.yaml, not here.

# LLM (OpenAI-compatible API)
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# Web search (only needed with enable_web_search)
TAVILY_API_KEY=

# Services from docker compose
REDIS_URL=redis://localhost:6379
MILVUS_URI=http://localhost:19530

# Read by Hugging Face libraries, not by Settings: use cached models only
HF_HUB_OFFLINE=1
